---
import { pwaInfo } from 'virtual:pwa-info'; // eslint-disable-line

import { Reload } from '@/components/reload';

import { count } from '@/lib/sounds';

import '@/styles/global.css';
import '@/styles/softcloud.css';

interface Props {
  description?: string;
  title?: string;
}

const title = Astro.props.title || '软云专注 | SoftCloud';
const description =
  Astro.props.description ||
  `软云专注提供 ${count()} 种环境声音，可自由混音，搭配番茄钟和睡眠定时器，陪你学习、工作和休息。`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <meta content="#18181b" name="theme-color" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('moodist-theme');
        const preference = ['system', 'light', 'dark'].includes(saved)
          ? saved
          : 'system';
        const theme =
          preference === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#122b40' : '#f7fbfe');
      })();
    </script>
    <link href="/softcloud.png" rel="icon" type="image/png" />

    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="软云专注" property="og:site_name" />
    <meta content="https://focus.zoci.pro" property="og:url" />
    <meta content="website" property="og:type" />
    <meta content="https://focus.zoci.pro/softcloud.png" property="og:image" />

    <meta content="summary_large_image" name="twitter:card" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <slot />

    <Reload client:load />
  </body>
</html>
